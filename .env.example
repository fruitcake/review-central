APP_NAME="Review Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Optional: tells open pages when a review starts, prints or ends, so they need not
# ask. `pusher` or `mercure`; `null` leaves the pages asking every few seconds.
BROADCAST_CONNECTION=null

# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=eu
# For a server of your own that speaks Pusher's protocol (Reverb, Soketi):
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https

# MERCURE_URL=https://review.example.com/.well-known/mercure
# MERCURE_PUBLIC_URL=https://review.example.com/.well-known/mercure
# MERCURE_JWT_SECRET=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# How reviews run: diff, docker or cloudflare. The platform's runner until an
# administrator picks one under Admin → Settings; a repository can pick its own.
# The diff needs nothing but an AI provider's key, and is the default.
# REVIEW_DEFAULT_RUNNER=diff
# REVIEW_DIFF_ENABLED=true
# REVIEW_DIFF_MAX_BYTES=600000

# Cloudflare sandboxes on this machine, through `npx wrangler dev` in cloudflare/worker.
# REVIEW_CLOUDFLARE_LOCAL=true

# Docker on this installation's own queue worker, once it has Docker, gVisor and the image.
REVIEW_DOCKER_ENABLED=false
REVIEW_CONTAINER_RUNTIME=runsc
REVIEW_CONTAINER_IMAGE=review-central/reviewer:latest
# With Redis and Horizon: the connection whose retry_after fits a review.
# REVIEW_CONTAINER_CONNECTION=reviews
# REVIEW_CONTAINER_PROCESSES=2
