APP_NAME="Review Central"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Optional: tells open pages when a review starts, prints or ends, so they need not
# ask. `pusher` or `mercure`; `null` leaves the pages asking every few seconds.
BROADCAST_CONNECTION=null

# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=eu
# For a server of your own that speaks Pusher's protocol (Reverb, Soketi):
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https

# MERCURE_URL=https://review.example.com/.well-known/mercure
# MERCURE_PUBLIC_URL=https://review.example.com/.well-known/mercure
# MERCURE_JWT_SECRET=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# How reviews run: diff, docker or cloudflare. The platform's runner until an
# administrator picks one under Admin → Settings; a repository can pick its own.
# Unset: a Cloudflare sandbox once it is set up, else the diff, which needs
# nothing but an AI provider's key. Docker runs only when it is picked.
# REVIEW_DEFAULT_RUNNER=cloudflare
# REVIEW_DIFF_ENABLED=true
# REVIEW_DIFF_MAX_BYTES=600000

# Cloudflare sandboxes (experimental): see cloudflare/README.md. Locally, through
# `npx wrangler dev` in cloudflare/worker:
# REVIEW_CLOUDFLARE_LOCAL=true
# Or a deployed Worker, with the R2 bucket it is bound to:
# REVIEW_CLOUDFLARE_URL=https://review-central-sandbox.<you>.workers.dev
# REVIEW_CLOUDFLARE_TOKEN=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Docker on this installation's own queue worker, once it has Docker, gVisor and the image.
REVIEW_DOCKER_ENABLED=false
REVIEW_CONTAINER_RUNTIME=runsc
REVIEW_CONTAINER_IMAGE=review-central/reviewer:latest
# With Redis and Horizon: the connection whose retry_after fits a review.
# REVIEW_CONTAINER_CONNECTION=reviews
# REVIEW_CONTAINER_PROCESSES=2
# Without Redis, the database queue: above the longest a review job may take
# (three rounds of REVIEW_CONTAINER_TIMEOUT + 600 seconds), or it starts twice.
# DB_QUEUE_RETRY_AFTER=7500

# Sign in with Google: an OAuth client with <APP_URL>/sign-in/google/callback as
# its redirect address. Without both, the sign-in page has no Google button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Connect Asana and Jira by signing in there rather than pasting a token: an OAuth
# app at each, with <APP_URL>/connections/oauth/callback as its redirect address.
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=

# A GitHub App to review as, instead of a token per connection. See the docs:
# Installation, "GitHub App".
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=storage/app/github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=

# Where an MCP client may have its sign-in sent, beyond Claude, ChatGPT, VS Code,
# Cursor and localhost: origins or schemes, comma separated. Also under Admin →
# Settings. "*" allows any domain.
# MCP_REDIRECT_DOMAINS=https://assistant.example.com,zed://

# Every other setting, with its default, is in the docs:
# https://review-central.com/guide/configuration
