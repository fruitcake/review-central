{
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Skill",
      "Task",
      "Agent",
      "Edit(ai-review.json)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git cat-file *)",
      "Bash(git fetch *)",
      "Bash(ocr *)",
      "Bash(php --version)",
      "Bash(sh .review/skill/floor-guard.sh *)"
    ],
    "deny": [
      "Edit(.git/**)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(//proc/**)",
      "Bash(cat /proc/*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(php artisan tinker*)",
      "Bash(php -r *)",
      "Bash(composer install*)",
      "Bash(composer update*)",
      "Bash(composer require*)",
      "Bash(composer remove*)",
      "Bash(composer run*)",
      "Bash(composer exec*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git stash*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull*)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git worktree *)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git tag *)"
    ]
  }
}
